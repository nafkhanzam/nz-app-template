# Server
APP_NAME="nz-app-template"
APP_ENV="development"
VERBOSE="true"
DATABASE_URL="postgresql://nafkhanzam:<DATABASE_PASSWORD>@a.nafkhanzam.com/$APP_NAME-$APP_ENV"
JWT_ACCESS_KEY="<JWT_ACCESS_KEY>"
JWT_REFRESH_KEY="<JWT_REFRESH_KEY>"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="nafkhanzam"
AWS_SECRET_ACCESS_KEY="<AWS_SECRET_ACCESS_KEY>"
AWS_S3_BUCKET="$APP_NAME-$APP_ENV"
AWS_S3_ENDPOINT="https://s3.nafkhanzam.com"
TYPST_API_SECRET_TOKEN="<TYPST_API_SECRET_TOKEN>"

OIDC_ISSUER="<OIDC_ISSUER>"
OIDC_CLIENT_ID="<OIDC_CLIENT_ID>"
OIDC_CLIENT_SECRET="<OIDC_CLIENT_SECRET>"
OIDC_REDIRECT_URI="<OIDC_REDIRECT_URI>"
OIDC_DIRECT_URI="<OIDC_DIRECT_URI>"

LOKI_URL="<LOKI_URL>"

# Web (only PUBLIC_* reaches the client bundle)
PUBLIC_ENVIRONMENT="$APP_ENV"
PUBLIC_LOCALE="id-ID"
PUBLIC_BACKEND_URL="http://localhost:3000"
PUBLIC_S3_ENDPOINT="https://s3.nafkhanzam.com/$APP_NAME-$APP_ENV"
PUBLIC_ENABLE_LOGGING=false
