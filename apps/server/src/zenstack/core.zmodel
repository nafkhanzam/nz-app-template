import './app'

type ID {
  id String @id @default(cuid())
}

type Timestamps {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type Base with ID, Timestamps {
}

type AuthInfo {
  id            String
  username      String
  role          Role
  name          String?
  email         String?
  image         String?
  permissions   String[]
  impersonation String?

  @@auth
}

enum Role {
  ADMIN
  USER
}

model RolePermission {
  role        Role     @id
  permissions String[]
}

model User with Base {
  username      String         @unique
  passwordHash  String         @allow('all', auth().id == id || auth().role == ADMIN)
  name          String
  email         String?
  role          Role
  permissions   String[]       @default([])

  image         String?

  Oidc          UserOidc[]
  RefreshToken  RefreshToken[]
  File          File[]
  Post          Post[]
  Report        Report[]    @relation("ReportAuthor")
  ReportReplied Report[]    @relation("ReportResponder")

  @@allow('read', true)
  @@allow('create', auth().role == ADMIN)
  @@allow('all', auth().id == id || auth().role == ADMIN)
}

model UserOidc with Base {
  userId   String
  User     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issuer   String
  sub      String
  userInfo Json

  @@unique([issuer, sub])

  @@allow('read', auth().id == userId || auth().role == ADMIN)
  @@allow('delete', auth().id == userId || auth().role == ADMIN)
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

model File with Timestamps {
  key              String     @id

  userId           String
  User             User       @relation(fields: [userId], references: [id])

  originalFilename String
  filename         String
  contentType      String
  size             Int?
  status           FileStatus

  Post             Post[]
  Report           Report[]

  @@allow('read', true)
  @@allow('all', auth().id == userId)
}

model RefreshToken with Base {
  userId  String
  User    User    @relation(fields: [userId], references: [id])

  revoked Boolean

  @@deny('all', true)
}

model AppConfig with Timestamps {
  key   String @id
  value Json

  @@allow('all', auth().role == ADMIN)
}

enum ReportType {
  BUG
  FEEDBACK
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Report with Base {
  userId      String
  User        User         @relation("ReportAuthor", fields: [userId], references: [id])

  type        ReportType
  status      ReportStatus @default(OPEN)

  title       String
  description String?

  fileKey     String?
  File        File?        @relation(fields: [fileKey], references: [key])

  response      String?      @allow('update', auth().role == ADMIN)
  respondedAt   DateTime?    @allow('update', auth().role == ADMIN)
  respondedById String?      @allow('update', auth().role == ADMIN)
  RespondedBy   User?        @relation("ReportResponder", fields: [respondedById], references: [id])

  @@allow('create', auth().id == userId)
  @@allow('read,update,delete', auth().id == userId && status == OPEN)
  @@allow('read', auth().id == userId)
  @@allow('all', auth().role == ADMIN)

  @@index([userId])
}
