import './app'

type ID {
  id String @id @default(cuid())
}

type Timestamps {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type Base with ID, Timestamps {
}

type AuthInfo {
  id            String
  username      String
  role          Role
  name          String?
  email         String?
  image         String?
  permissions   String[]
  impersonation String?

  @@auth
}

enum Role {
  ADMIN
  USER
}

model RolePermission {
  role        Role     @id
  permissions String[]
}

model User with Base {
  username      String         @unique
  passwordHash  String         @allow('all', auth().id == id || auth().role == ADMIN)
  name          String
  email         String?
  role          Role
  permissions   String[]       @default([])

  image         String?

  Oidc          UserOidc[]
  RefreshToken  RefreshToken[]
  File          File[]
  Post          Post[]

  @@allow('read', true)
  @@allow('create', auth().role == ADMIN)
  @@allow('all', auth().id == id || auth().role == ADMIN)
}

model UserOidc with Base {
  userId   String
  User     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issuer   String
  sub      String
  userInfo Json

  @@unique([issuer, sub])

  @@allow('read', auth().id == userId || auth().role == ADMIN)
  @@allow('delete', auth().id == userId || auth().role == ADMIN)
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

model File with Timestamps {
  key              String     @id

  userId           String
  User             User       @relation(fields: [userId], references: [id])

  originalFilename String
  filename         String
  contentType      String
  size             Int?
  status           FileStatus

  Post             Post[]

  @@allow('read', true)
  @@allow('all', auth().id == userId)
}

model RefreshToken with Base {
  userId  String
  User    User    @relation(fields: [userId], references: [id])

  revoked Boolean

  @@deny('all', true)
}

model AppConfig with Timestamps {
  key   String @id
  value Json

  @@allow('all', auth().role == ADMIN)
}
