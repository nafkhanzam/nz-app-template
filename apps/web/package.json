{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "../../envs/run localdev vite dev",
    "build": "vite build",
    "build:production": "../../envs/run production vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "pnpm check",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:codegen": "playwright codegen",
    "test:record": "playwright codegen http://localhost:5173 --output tests/recorded.spec.ts",
    "test:record:user1": "playwright codegen http://localhost:5173 --output tests/_temp-user1.spec.ts",
    "test:record:user2": "playwright codegen http://localhost:5173 --output tests/_temp-user2.spec.ts",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@iconify/svelte": "5.2.3",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/svelte-query": "6.3.6",
    "@tanstack/svelte-query-devtools": "6.3.6",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@types/event-source-polyfill": "1.0.5",
    "@types/katex": "0.16.8",
    "@types/papaparse": "5.5.2",
    "@zenstackhq/orm": "catalog:",
    "@zenstackhq/tanstack-query": "catalog:",
    "buffer": "6.0.3",
    "daisyui": "5.7.50",
    "nanoid": "6.0.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "server": "workspace:*",
    "superjson": "2.2.6",
    "svelecte": "5.4.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "svelte-french-toast": "1.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0",
    "zenstack-trpc": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "event-source-polyfill": "1.0.31",
    "jsqr": "1.4.0",
    "jszip": "3.10.1",
    "katex": "0.18.7",
    "marked": "18.0.10",
    "monaco-editor": "0.56.0",
    "papaparse": "5.7.0",
    "xlsx": "0.18.5"
  }
}
