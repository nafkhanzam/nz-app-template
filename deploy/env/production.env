# Plaintext, ikut di-git — tidak ada rahasia di sini (§4.4).
# Ganti domain = ubah BASE_DOMAIN, satu baris, tanpa menyentuh SOPS.

APP_NAME=nz-app-template
APP_ENV=production

# Placeholder — ganti ke domain nyata sebelum deploy pertama.
BASE_DOMAIN=nafkhan.id

# Perlu diisi alamat asli sebelum Caddy bisa minta sertifikat Let's Encrypt.
ACME_EMAIL=<FILL_WITH_REAL_EMAIL>

# Jeda sebelum slot lama di-stop saat blue-green switch (§4.2 poin 6).
DRAIN_SECONDS=20
