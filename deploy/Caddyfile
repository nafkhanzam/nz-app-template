# Edge proxy — §4.3. Hostnames are explicit (from env, populated by
# docker-compose.proxy.yml from the four-domain convention in §4.4), not
# wildcard, so no DNS-01 challenge or DNS provider API token is needed.
#
# BOOTSTRAP ORDER: the `import` lines below need /etc/caddy/slots/*.caddy to
# already exist — deploy.sh only creates them after a successful deploy, but
# caddy-edge (this config) is meant to start independently, before any
# deploy has ever run. On a fresh VPS, seed placeholders first:
#   mkdir -p /srv/<app>/<env>/slots
#   echo 'reverse_proxy server-blue:3000' > /srv/<app>/<env>/slots/server.caddy
#   echo 'reverse_proxy web-blue:80' > /srv/<app>/<env>/slots/web.caddy
# deploy.sh's first run overwrites these with the real target anyway.
{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$SERVER_DOMAIN} {
	import common
	import /etc/caddy/slots/server.caddy
}

{$WEB_DOMAIN} {
	import common
	import /etc/caddy/slots/web.caddy
}

{$S3_API_DOMAIN} {
	import common
	reverse_proxy garage:3900
}

{$S3_WEB_DOMAIN} {
	import common
	reverse_proxy garage:3902
}
